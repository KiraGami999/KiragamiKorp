# Copy this file to .env.local and fill in your keys.
# Get a free Groq key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides. Any OpenAI-compatible endpoint works.
# LLM_MODEL=openai/gpt-oss-20b   (or openai/gpt-oss-120b for higher quality)
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Neon Postgres — use the kiragamikorp database (not neondb)
# Example: ...neon.tech/kiragamikorp?sslmode=require
DATABASE_URL=

# Cookie signing secret (required in production)
ADMIN_SESSION_SECRET=

# Optional env fallbacks if DB auth rows are missing
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# GATE_PHRASE=Screw Arasaka
