# Copy this file to .env.local and fill in your key.
# Get a free Groq key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides. Any OpenAI-compatible endpoint works.
# LLM_MODEL=openai/gpt-oss-20b   (or openai/gpt-oss-120b for higher quality)
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Local Ollama instead of Groq:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
